{% extends 'base.html.twig' %}

{% block title %}{{ 'chat.unavailable_title'|trans }}{% endblock %}

{% block body %}
    <div style="max-width: 560px; margin: 80px auto; padding: 0 24px; text-align: center;">
        <h1 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 12px;">
            {{ 'chat.unavailable_title'|trans }}
        </h1>
        <p style="font-size: 0.95rem; color: #64748b;">
            {{ (chatbotEnabled ? 'chat.unavailable_coming_soon' : 'chat.unavailable_disabled')|trans }}
        </p>
    </div>
{% endblock %}
