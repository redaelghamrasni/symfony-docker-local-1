{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.settings.title'|trans }} - Admin{% endblock %}
{% block page_title %}{{ 'admin.settings.title'|trans }}{% endblock %}

{% block content %}
<style>
    .settings-card summary::-webkit-details-marker { display: none; }
    .settings-card summary { list-style: none; }
    .settings-card .settings-card-chevron { transition: transform 0.2s ease; color: #94a3b8; }
    .settings-card[open] .settings-card-chevron { transform: rotate(180deg); }
</style>
<div style="max-width: 720px;">
    <form id="settings-form" method="POST" action="{{ path('admin_settings_index') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_settings') }}">
    </form>

    <details class="settings-card" open style="background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; margin-bottom: 24px;">
        <summary style="padding: 20px 24px; border-bottom: 1px solid #e2e8f0; background: #f8fafc; cursor: pointer; display: flex; align-items: center; justify-content: space-between; user-select: none;">
            <h2 style="margin: 0; font-size: 1rem; font-weight: 600; color: #0f172a;">{{ 'admin.settings.general_section'|trans }}</h2>
            <i class="bi bi-chevron-down settings-card-chevron"></i>
        </summary>

        <div style="padding: 24px; display: flex; flex-direction: column; gap: 20px;">
            {% for setting in settings %}
                {% if setting.key != 'chatbot.model' %}
                    <div>
                        <label for="setting_{{ setting.key }}" style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 6px;">
                            {{ setting.label }}
                        </label>
                        {% if setting.type == 'number' %}
                            <input type="number" step="0.01" min="0"
                                   form="settings-form"
                                   id="setting_{{ setting.key }}"
                                   name="settings[{{ setting.key }}]"
                                   value="{{ setting.value ?? '' }}"
                                   placeholder="0.00"
                                   style="width: 100%; max-width: 240px; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 0.875rem; color: #0f172a; background: #f9fafb;">
                        {% elseif setting.type == 'select' %}
                            <select form="settings-form"
                                    id="setting_{{ setting.key }}"
                                    name="settings[{{ setting.key }}]"
                                    style="width: 100%; max-width: 240px; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 0.875rem; color: #0f172a; background: #f9fafb;">
                                {% for option in selectOptions[setting.key] ?? [] %}
                                    <option value="{{ option }}" {% if option == setting.value %}selected{% endif %}>{{ option }}</option>
                                {% endfor %}
                            </select>
                        {% elseif setting.type == 'textarea' %}
                            <textarea form="settings-form"
                                      id="setting_{{ setting.key }}"
                                      name="settings[{{ setting.key }}]"
                                      rows="4"
                                      style="width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 0.875rem; color: #0f172a; background: #f9fafb; resize: vertical;">{{ setting.value ?? '' }}</textarea>
                        {% else %}
                            <input type="text"
                                   form="settings-form"
                                   id="setting_{{ setting.key }}"
                                   name="settings[{{ setting.key }}]"
                                   value="{{ setting.value ?? '' }}"
                                   style="width: 100%; max-width: 400px; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 0.875rem; color: #0f172a; background: #f9fafb;">
                        {% endif %}
                        {% if setting.key == 'shipping.free_threshold' %}
                            <p style="margin: 4px 0 0; font-size: 0.8rem; color: #64748b;">{{ 'admin.settings.free_threshold_hint'|trans }}</p>
                        {% endif %}
                    </div>
                {% endif %}
            {% else %}
                <p style="color: #94a3b8; font-size: 0.875rem;">{{ 'admin.settings.no_settings'|trans }}</p>
            {% endfor %}
        </div>
    </details>

    <details class="settings-card" style="background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; margin-bottom: 24px;">
        <summary style="padding: 20px 24px; border-bottom: 1px solid #e2e8f0; background: #f8fafc; cursor: pointer; display: flex; align-items: center; justify-content: space-between; user-select: none;">
            <h2 style="margin: 0; font-size: 1rem; font-weight: 600; color: #0f172a;">{{ 'admin.settings.chatbot_model_storage_section'|trans }}</h2>
            <i class="bi bi-chevron-down settings-card-chevron"></i>
        </summary>
        <div style="padding: 24px;">
            {% for setting in settings %}
              {% if setting.key == 'chatbot.model' %}
                <div style="margin-bottom: {{ chatbotDownloadedModels is not empty ? '24px' : '0' }};">
                    <label for="setting_{{ setting.key }}" style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 6px;">
                        {{ setting.label }}
                    </label>
                    <select form="settings-form"
                            id="setting_{{ setting.key }}"
                            name="settings[{{ setting.key }}]"
                            data-chatbot-model-select
                            style="width: 100%; max-width: 240px; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 0.875rem; color: #0f172a; background: #f9fafb;">
                        {% for option in selectOptions[setting.key] ?? [] %}
                            <option value="{{ option }}" {% if option == setting.value %}selected{% endif %}>{{ option }}</option>
                        {% endfor %}
                    </select>
                    <p style="margin: 6px 0 0; font-size: 0.8rem;">
                        <span data-chatbot-model-dot style="color: {{ chatbotModelReady ? '#16a34a' : '#d97706' }};">&#9679;</span>
                        <span data-chatbot-model-text>{{ chatbotModelReady ? 'admin.settings.chatbot_model_ready'|trans : 'admin.settings.chatbot_model_not_ready'|trans }}</span>
                    </p>
                    <p style="margin: 2px 0 0; font-size: 0.75rem; color: #94a3b8;">
                        {{ 'admin.settings.chatbot_model_unsaved_hint'|trans }}
                    </p>
                    <p style="margin: 4px 0 0; font-size: 0.8rem; color: #64748b;">{{ 'admin.settings.chatbot_model_hint'|trans }}</p>
                    <script type="application/json" data-chatbot-model-availability>{{ chatbotModelAvailability|json_encode|raw }}</script>
                    <script>
                        (function () {
                            var select = document.querySelector('[data-chatbot-model-select]');
                            var dot = document.querySelector('[data-chatbot-model-dot]');
                            var text = document.querySelector('[data-chatbot-model-text]');
                            var dataEl = document.querySelector('[data-chatbot-model-availability]');
                            if (!select || !dot || !text || !dataEl) { return; }

                            var availability = JSON.parse(dataEl.textContent);
                            var readyLabel = {{ 'admin.settings.chatbot_model_ready'|trans|json_encode|raw }};
                            var notReadyLabel = {{ 'admin.settings.chatbot_model_not_ready'|trans|json_encode|raw }};

                            select.addEventListener('change', function () {
                                var ready = !!availability[select.value];
                                dot.style.color = ready ? '#16a34a' : '#d97706';
                                text.textContent = ready ? readyLabel : notReadyLabel;
                            });
                        })();
                    </script>
                </div>
              {% endif %}
            {% endfor %}

            {% if chatbotDownloadedModels is not empty %}
                <p style="margin: 0 0 16px; font-size: 0.8125rem; color: #64748b;">
                    {{ 'admin.settings.chatbot_model_storage_hint'|trans }}
                </p>

                <table style="width: 100%; border-collapse: collapse;">
                    <tbody>
                        {% for model in chatbotDownloadedModels %}
                            <tr style="border-top: 1px solid #e2e8f0;">
                                <td style="padding: 10px 0; font-size: 0.875rem; color: #0f172a; font-family: monospace;">{{ model }}</td>
                                <td style="padding: 10px 0; text-align: right;">
                                    <form method="POST" action="{{ path('admin_settings_chatbot_model_free_space') }}" style="margin: 0;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_settings_free_space') }}">
                                        <input type="hidden" name="model" value="{{ model }}">
                                        <button type="submit" title="{{ 'admin.settings.chatbot_model_free_space'|trans }}" style="
                                            display: inline-flex; align-items: center; justify-content: center;
                                            width: 32px; height: 32px; background: #fff; color: #b91c1c;
                                            border: 1px solid #fecaca; border-radius: 8px; cursor: pointer;
                                        ">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                {% if chatbotDownloadedModels|length > 1 %}
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 16px;">
                        <p style="margin: 0; font-size: 0.875rem; color: #374151;">
                            {{ 'admin.settings.chatbot_model_free_all_hint'|trans }}
                        </p>
                        <form method="POST" action="{{ path('admin_settings_chatbot_model_free_all_space') }}" style="margin: 0;"
                              onsubmit="return confirm({{ 'admin.settings.chatbot_model_free_all_confirm'|trans|json_encode|raw }});">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_settings_free_all_space') }}">
                            <button type="submit" style="
                                display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
                                padding: 9px 18px; background: #b91c1c; color: #fff;
                                border: 1px solid #b91c1c; border-radius: 8px; font-size: 0.8125rem; font-weight: 600;
                                cursor: pointer;
                            ">
                                <i class="bi bi-trash3"></i>
                                {{ 'admin.settings.chatbot_model_free_all'|trans }}
                            </button>
                        </form>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </details>

    <button type="submit" form="settings-form" style="
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 24px; background: #0f172a; color: #fff;
        border: none; border-radius: 8px; font-size: 0.875rem; font-weight: 600;
        cursor: pointer; transition: background 0.15s;
    " onmouseover="this.style.background='#1e293b'" onmouseout="this.style.background='#0f172a'">
        <i class="bi bi-check-lg"></i>
        {{ 'admin.settings.save'|trans }}
    </button>
</div>
{% endblock %}
