{% extends 'admin/base.html.twig' %}

{% block title %}{{ isEdit ? 'common.edit'|trans : 'admin.faq.form.new_entry'|trans }} - Admin{% endblock %}
{% block page_title %}{{ isEdit ? 'common.edit'|trans : 'admin.faq.form.new_entry'|trans }}{% endblock %}

{% block breadcrumb %}
<p style="margin: -8px 0 20px 0; font-size: 12px; color: #8a9ab5;">
    <a href="{{ path('admin_faq_index') }}" style="color: #8a9ab5; text-decoration: none;">{{ 'admin.faq.index.breadcrumb'|trans }}</a>
    &nbsp;/&nbsp;{{ isEdit ? (fr ?? en).question|slice(0, 40) : 'admin.faq.form.new_entry'|trans }}
</p>
{% endblock %}

{% block content %}

{{ form_start(form, {'attr': {'id': 'faq-form', 'novalidate': 'novalidate'}}) }}

<div style="display: flex; justify-content: flex-end; gap: 10px; margin-bottom: 24px;">
    <a href="{{ path('admin_faq_index') }}" class="btn-action-secondary">
        <i class="bi bi-x-lg"></i> {{ 'common.cancel'|trans }}
    </a>
    <button type="submit" form="faq-form" class="btn-action-primary">
        <i class="bi bi-check-lg"></i> {{ isEdit ? 'common.save_changes'|trans : 'admin.faq.form.create_btn'|trans }}
    </button>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
    {% for locale, field in {'fr': {category: form.category_fr, question: form.question_fr, answer: form.answer_fr}, 'en': {category: form.category_en, question: form.question_en, answer: form.answer_en}} %}
    <div style="background: white; border: 1px solid #d6dde6; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06);">
        <div style="padding: 16px 24px; background: #f8fafc; border-bottom: 1px solid #d6dde6;">
            <h2 style="margin: 0; font-size: 13px; font-weight: 700; color: #1a2340; text-transform: uppercase; letter-spacing: 0.05em;">
                {{ locale == 'fr' ? 'admin.faq.form.panel_fr'|trans : 'admin.faq.form.panel_en'|trans }}
            </h2>
        </div>
        <div style="padding: 28px 24px; display: flex; flex-direction: column; gap: 20px;">

            <div>
                <label style="display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: #374155; text-transform: uppercase; letter-spacing: 0.04em;">
                    {{ 'admin.faq.form.category_label'|trans }}
                </label>
                {{ form_widget(field.category, {
                    'attr': {
                        'style': 'width: 100%; padding: 10px 14px; border: 1px solid #d6dde6; border-radius: 6px; font-size: 15px; color: #1a2340; background: #f8fafc; box-sizing: border-box;',
                        'placeholder': 'admin.faq.form.category_placeholder'|trans,
                    }
                }) }}
                <div style="color: #dc2626; font-size: 13px; margin-top: 4px;">{{ form_errors(field.category) }}</div>
            </div>

            <div>
                <label style="display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: #374155; text-transform: uppercase; letter-spacing: 0.04em;">
                    {{ 'admin.faq.form.question_label'|trans }}
                </label>
                {{ form_widget(field.question, {
                    'attr': {
                        'style': 'width: 100%; padding: 10px 14px; border: 1px solid #d6dde6; border-radius: 6px; font-size: 15px; color: #1a2340; background: #f8fafc; box-sizing: border-box; resize: vertical;',
                        'placeholder': 'admin.faq.form.question_placeholder'|trans,
                    }
                }) }}
                <div style="color: #dc2626; font-size: 13px; margin-top: 4px;">{{ form_errors(field.question) }}</div>
            </div>

            <div>
                <label style="display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: #374155; text-transform: uppercase; letter-spacing: 0.04em;">
                    {{ 'admin.faq.form.answer_label'|trans }}
                </label>
                {{ form_widget(field.answer, {
                    'attr': {
                        'style': 'width: 100%; padding: 10px 14px; border: 1px solid #d6dde6; border-radius: 6px; font-size: 15px; color: #1a2340; background: #f8fafc; box-sizing: border-box; resize: vertical;',
                        'placeholder': 'admin.faq.form.answer_placeholder'|trans,
                    }
                }) }}
                <div style="color: #dc2626; font-size: 13px; margin-top: 4px;">{{ form_errors(field.answer) }}</div>
            </div>

        </div>
    </div>
    {% endfor %}
</div>

<div style="display: flex; justify-content: flex-end; gap: 10px; padding-bottom: 16px;">
    <a href="{{ path('admin_faq_index') }}" class="btn-action-secondary">
        <i class="bi bi-x-lg"></i> {{ 'common.cancel'|trans }}
    </a>
    <button type="submit" form="faq-form" class="btn-action-primary">
        <i class="bi bi-check-lg"></i> {{ isEdit ? 'common.save_changes'|trans : 'admin.faq.form.create_btn'|trans }}
    </button>
</div>

{{ form_end(form) }}

{% endblock %}
