<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}{{ 'admin.nav.panel'|trans }} - {{ 'nav.app_name'|trans }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/custom.css') }}">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="h-full bg-zinc-50 antialiased admin-body">
        <div class="admin-sidebar-backdrop" id="adminBackdrop"></div>
        <button class="admin-sidebar-toggle" id="adminSidebarToggle" aria-label="Toggle menu">
            <i class="bi bi-list" id="adminSidebarToggleIcon"></i>
        </button>
        <div class="admin-layout">
            {# Sidebar Navigation #}
            <nav class="admin-sidebar" id="adminSidebar">
                <span class="admin-badge">{{ 'admin.nav.badge'|trans }}</span>
                <div class="admin-logo">
                    <i class="bi bi-speedometer2"></i>
                    {{ app.user ? app.user.username : 'admin.nav.panel'|trans }}
                </div>

                <div class="admin-nav">
                    <a href="{{ path('admin_dashboard') }}" class="admin-nav-item {% if 'admin_dashboard' == app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-house-door"></i>
                        {{ 'admin.nav.dashboard'|trans }}
                    </a>
                    <a href="{{ path('admin_articles_index') }}" class="admin-nav-item {% if 'admin_articles_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-newspaper"></i>
                        {{ 'admin.nav.articles'|trans }}
                    </a>
                    <a href="{{ path('admin_users_index') }}" class="admin-nav-item {% if 'admin_users_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-people"></i>
                        {{ 'admin.nav.users'|trans }}
                    </a>
                    <a href="{{ path('admin_orders_index') }}" class="admin-nav-item {% if 'admin_orders_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-bag"></i>
                        {{ 'admin.nav.orders'|trans }}
                    </a>
                    <a href="{{ path('admin_quotes_index') }}" class="admin-nav-item {% if 'admin_quotes_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-receipt-cutoff"></i>
                        {{ 'admin.nav.quotes'|trans }}
                    </a>
                    <a href="{{ path('admin_reports_index') }}" class="admin-nav-item {% if 'admin_reports_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-bar-chart"></i>
                        {{ 'admin.nav.reports'|trans }}
                    </a>
                    <a href="{{ path('admin_categories_index') }}" class="admin-nav-item {% if 'admin_categories_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-tags"></i>
                        {{ 'admin.nav.categories'|trans }}
                    </a>
                    <a href="{{ path('admin_promotions_index') }}" class="admin-nav-item {% if 'admin_promotions_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-percent"></i>
                        {{ 'admin.nav.promotions'|trans }}
                    </a>
                    <a href="{{ path('admin_faq_index') }}" class="admin-nav-item {% if 'admin_faq_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-question-circle"></i>
                        {{ 'admin.nav.faq'|trans }}
                    </a>
                    <a href="{{ path('admin_settings_index') }}" class="admin-nav-item {% if 'admin_settings_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-gear"></i>
                        {{ 'admin.nav.settings'|trans }}
                    </a>
                    <a href="{{ path('admin_currencies_index') }}" class="admin-nav-item {% if 'admin_currencies_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-currency-exchange"></i>
                        {{ 'admin.nav.currencies'|trans }}
                    </a>
                    <a href="{{ path('admin_taxes_index') }}" class="admin-nav-item {% if 'admin_taxes_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-percent"></i>
                        {{ 'admin.nav.taxes'|trans }}
                    </a>
                    <a href="{{ path('admin_regions_index') }}" class="admin-nav-item {% if 'admin_regions_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-geo-alt"></i>
                        {{ 'admin.nav.regions'|trans }}
                    </a>
                    <a href="{{ path('admin_logs_index') }}" class="admin-nav-item {% if 'admin_logs_' in app.request.attributes.get('_route') %}active{% endif %}">
                        <i class="bi bi-journal-text"></i>
                        {{ 'admin.nav.logs'|trans }}
                    </a>
                </div>
            </nav>

            {# Main Content #}
            <div class="admin-content">
                {# Header #}
                <div class="admin-header">
                    <h1 class="admin-title">{% block page_title %}Admin{% endblock %}</h1>
                    {% if app.user %}
                    <div class="user-dropdown" id="adminUserDropdown">
                        <button class="user-dropdown-trigger" onclick="toggleAdminUserDropdown(event)">
                            <span style="display: flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border-radius: 9999px; background: #0f172a; color: #fff; font-size: 0.7rem; font-weight: 700; flex-shrink: 0;">
                                {{ app.user.getFirstName()|default(app.user.username)|slice(0, 1)|upper }}
                            </span>
                            {{ 'nav.welcome'|trans({'%name%': app.user.getFirstName()|default(app.user.username)}) }}
                            <i class="bi bi-chevron-down" style="font-size: 0.65rem;"></i>
                        </button>
                        <div class="user-dropdown-menu" id="adminUserDropdownMenu">
                            <div class="user-dropdown-header">
                                <div class="user-dropdown-name">{{ app.user.getFirstName() }} {{ app.user.getLastName() }}</div>
                                <div class="user-dropdown-email">{{ app.user.email }}</div>
                            </div>
                            <a href="{{ path('admin_users_show', {id: app.user.id}) }}">
                                <i class="bi bi-person"></i> {{ 'profile.index.title'|trans }}
                            </a>
                            <hr class="user-dropdown-divider">
                            <a href="{{ path('app_article_list') }}">
                                <i class="bi bi-shop"></i> {{ 'admin.nav.store'|trans }}
                            </a>
                            <hr class="user-dropdown-divider">
                            <a href="{{ path('app_auth_logout') }}" class="user-dropdown-logout">
                                <i class="bi bi-box-arrow-right"></i> {{ 'profile.logout'|trans }}
                            </a>
                        </div>
                    </div>
                    {% endif %}
                </div>

                {# Flash Messages #}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div style="
                            padding: 12px 16px;
                            margin-bottom: 20px;
                            border-radius: 6px;
                            {% if type == 'success' %}
                                background: #dcfce7;
                                border-left: 4px solid #22c55e;
                                color: #166534;
                            {% elseif type == 'error' %}
                                background: #fee2e2;
                                border-left: 4px solid #ef4444;
                                color: #991b1b;
                            {% else %}
                                background: #dbeafe;
                                border-left: 4px solid #3b82f6;
                                color: #1e40af;
                            {% endif %}
                        ">
                            {{ message | trans }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Breadcrumb #}
                {% block breadcrumb %}{% endblock %}

                {# Page Content #}
                {% block content %}{% endblock %}
            </div>
        </div>
    <script>
    (function () {
        const sidebar  = document.getElementById('adminSidebar') || document.querySelector('.admin-sidebar');
        const backdrop = document.getElementById('adminBackdrop');
        const toggle   = document.getElementById('adminSidebarToggle');
        const icon     = document.getElementById('adminSidebarToggleIcon');

        let pinned    = false;
        let hoverOpen = false;

        function open(pin) {
            sidebar.classList.add('open');
            backdrop.classList.add('visible');
            if (pin) { pinned = true; icon.className = 'bi bi-x-lg'; }
        }

        function close() {
            sidebar.classList.remove('open');
            backdrop.classList.remove('visible');
            pinned    = false;
            hoverOpen = false;
            icon.className = 'bi bi-list';
        }

        // Toggle button — always visible on mobile, works on desktop too
        toggle.addEventListener('click', function () {
            if (sidebar.classList.contains('open') && pinned) {
                close();
            } else {
                open(true);
            }
        });

        // Backdrop click closes
        backdrop.addEventListener('click', close);

        // Desktop: open when cursor enters the leftmost 5% of the viewport
        document.addEventListener('mousemove', function (e) {
            if (!sidebar.classList.contains('open') && e.clientX < window.innerWidth * 0.05) {
                hoverOpen = true;
                open(false);
            }
        });

        // Desktop: close on mouseleave only if opened by hover (not pinned)
        sidebar.addEventListener('mouseleave', function () {
            if (hoverOpen && !pinned) {
                hoverOpen = false;
                close();
            }
        });

        // Escape key closes
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && sidebar.classList.contains('open')) {
                close();
            }
        });
    })();

    // Admin user dropdown (mirrors the storefront user menu).
    function toggleAdminUserDropdown(e) {
        e.stopPropagation();
        var menu = document.getElementById('adminUserDropdownMenu');
        if (menu) menu.classList.toggle('open');
    }
    document.addEventListener('click', function () {
        var menu = document.getElementById('adminUserDropdownMenu');
        if (menu) menu.classList.remove('open');
    });
    </script>
    </body>
</html>
