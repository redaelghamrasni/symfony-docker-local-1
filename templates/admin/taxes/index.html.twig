{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.taxes.title'|trans }} - Admin{% endblock %}
{% block page_title %}{{ 'admin.taxes.title'|trans }}{% endblock %}

{% block breadcrumb %}
<p style="margin: -8px 0 20px 0; font-size: 12px; color: #8a9ab5;">{{ 'admin.taxes.breadcrumb'|trans }}</p>
{% endblock %}

{% block content %}
<div style="display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:18px; flex-wrap:wrap;">
    <p style="margin:0; color:#64748b; font-size:14px; max-width:72ch;">{{ 'admin.taxes.intro'|trans }}</p>
    <a href="{{ path('admin_taxes_new') }}" class="btn-action-primary" style="font-size:13px; padding:9px 16px; white-space:nowrap;">
        <i class="bi bi-plus-lg"></i> {{ 'admin.taxes.create'|trans }}
    </a>
</div>

<div style="background:#fff; border:1px solid #e2e8f0; border-radius:8px; overflow:hidden;">
    <div style="overflow-x:auto;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0;">
                <th style="padding:12px 16px; text-align:left; font-size:12px; text-transform:uppercase; letter-spacing:.05em; color:#64748b;">{{ 'admin.taxes.province'|trans }}</th>
                <th style="padding:12px 16px; text-align:left; font-size:12px; text-transform:uppercase; letter-spacing:.05em; color:#64748b;">{{ 'admin.taxes.name'|trans }}</th>
                <th style="padding:12px 16px; text-align:right; font-size:12px; text-transform:uppercase; letter-spacing:.05em; color:#64748b;">GST</th>
                <th style="padding:12px 16px; text-align:right; font-size:12px; text-transform:uppercase; letter-spacing:.05em; color:#64748b;">PST</th>
                <th style="padding:12px 16px; text-align:right; font-size:12px; text-transform:uppercase; letter-spacing:.05em; color:#64748b;">HST</th>
                <th style="padding:12px 16px; text-align:right; font-size:12px; text-transform:uppercase; letter-spacing:.05em; color:#64748b;">{{ 'admin.taxes.combined'|trans }}</th>
                <th style="padding:12px 16px; text-align:right;"></th>
            </tr>
        </thead>
        <tbody>
        {% for rate in rates %}
            <tr style="border-bottom:1px solid #f1f5f9;">
                <td style="padding:14px 16px; font-weight:700; color:#0f172a; font-size:13px;">{{ rate.province }}</td>
                <td style="padding:14px 16px; color:#0f172a; font-size:13px;">{{ rate.name }}</td>
                <td style="padding:14px 16px; text-align:right; font-family:monospace; font-size:13px; color:#475569; font-variant-numeric:tabular-nums;">{{ (rate.gst * 100)|number_format(3) }}%</td>
                <td style="padding:14px 16px; text-align:right; font-family:monospace; font-size:13px; color:#475569; font-variant-numeric:tabular-nums;">{{ (rate.pst * 100)|number_format(3) }}%</td>
                <td style="padding:14px 16px; text-align:right; font-family:monospace; font-size:13px; color:#475569; font-variant-numeric:tabular-nums;">{{ (rate.hst * 100)|number_format(3) }}%</td>
                <td style="padding:14px 16px; text-align:right; font-family:monospace; font-size:13px; font-weight:700; color:#0f172a; font-variant-numeric:tabular-nums;">{{ (rate.combinedRate * 100)|number_format(3) }}%</td>
                <td style="padding:14px 16px; text-align:right; white-space:nowrap;">
                    <a href="{{ path('admin_taxes_edit', {id: rate.id}) }}" class="btn-action-secondary" style="font-size:12px; padding:5px 12px;">
                        <i class="bi bi-pencil"></i> {{ 'admin.taxes.edit'|trans }}
                    </a>
                    <form method="post" action="{{ path('admin_taxes_delete', {id: rate.id}) }}" style="display:inline;"
                          onsubmit="return confirm('{{ 'admin.taxes.confirm_delete'|trans|e('js') }}');">
                        <input type="hidden" name="_token" value="{{ csrf_token('tax_delete_' ~ rate.id) }}">
                        <button type="submit" class="btn-action-secondary" style="font-size:12px; padding:5px 12px; color:#991b1b;">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>

<p style="margin-top:16px; font-size:12px; color:#8a9ab5; max-width:80ch;">
    <i class="bi bi-info-circle"></i> {{ 'admin.taxes.hint_snapshot'|trans }}
</p>
{% endblock %}
