<div style="font-family: Arial, sans-serif; color: #1f2937; max-width: 600px; margin: 0 auto;">

    <h1 style="color: #111827; margin-bottom: 4px;">{{ ('email.order_status_changed.title_' ~ order.status)|trans }}</h1>
    <p>{{ 'email.order_status_changed.greeting'|trans({'%name%': order.customerFirstName}) }}</p>
    <p>{{ ('email.order_status_changed.body_' ~ order.status)|trans({'%id%': order.id}) }}</p>

    <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px;">
        <tr>
            <td style="padding: 10px 16px; font-weight: bold; color: #6b7280; width: 40%;">{{ 'email.order_confirmation.order_number'|trans }}</td>
            <td style="padding: 10px 16px;">#{{ order.id }}</td>
        </tr>
        <tr style="background: #f3f4f6;">
            <td style="padding: 10px 16px; font-weight: bold; color: #6b7280;">{{ 'email.order_confirmation.order_status'|trans }}</td>
            <td style="padding: 10px 16px;">
                <span style="display: inline-block; padding: 2px 10px; background: #dbeafe; color: #1d4ed8; border-radius: 12px; font-size: 13px; font-weight: bold;">
                    {{ ('email.order_confirmation.status_' ~ order.status)|trans }}
                </span>
            </td>
        </tr>
        {% if order.status in ['shipped', 'completed'] %}
            {% if order.shippingCarrier %}
            <tr style="background: #f3f4f6;">
                <td style="padding: 10px 16px; font-weight: bold; color: #6b7280;">{{ 'email.order_status_changed.carrier'|trans }}</td>
                <td style="padding: 10px 16px;">{{ order.shippingCarrier }}</td>
            </tr>
            {% endif %}
            {% if order.trackingNumber %}
            <tr>
                <td style="padding: 10px 16px; font-weight: bold; color: #6b7280;">{{ 'email.order_status_changed.tracking_number'|trans }}</td>
                <td style="padding: 10px 16px;"><code>{{ order.trackingNumber }}</code></td>
            </tr>
            {% endif %}
            {% if order.estimatedDeliveryDate %}
            <tr style="background: #f3f4f6;">
                <td style="padding: 10px 16px; font-weight: bold; color: #6b7280;">
                    {{ (order.status == 'completed' ? 'email.order_status_changed.delivered_date' : 'email.order_status_changed.estimated_delivery')|trans }}
                </td>
                <td style="padding: 10px 16px;">
                    {% if locale starts with 'fr' %}
                        {% set frMonths = ['', 'janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}
                        {{ order.estimatedDeliveryDate|date('j') }} {{ frMonths[order.estimatedDeliveryDate|date('n')] }} {{ order.estimatedDeliveryDate|date('Y') }}
                    {% else %}
                        {{ order.estimatedDeliveryDate|date('F j, Y') }}
                    {% endif %}
                </td>
            </tr>
            {% endif %}
        {% endif %}
    </table>

    {% if orderUrl %}
    <p style="text-align: center; margin: 32px 0;">
        <a href="{{ orderUrl }}" style="display:inline-block;padding:12px 24px;background-color:#0f172a;color:white;text-decoration:none;border-radius:4px;font-weight:bold;">
            {{ 'email.order_status_changed.view_order_button'|trans }}
        </a>
    </p>
    {% endif %}

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;">

    <p>{{ 'email.order_confirmation.questions'|trans }}</p>
    <p>{{ 'email.order_confirmation.goodbye'|trans }}</p>
    <p>{{ 'email.order_confirmation.team'|trans({'%app%': 'nav.app_name'|trans}) }}</p>

</div>
